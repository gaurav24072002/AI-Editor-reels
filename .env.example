# 11 Second Edit — environment
# Copy to .env (or export in your shell). Never commit real keys.

# Auphonic API key — used for "Enhance audio" (cloud).
# Leave unset to use the built-in FFmpeg loudnorm fallback instead.
AUPHONIC_API_KEY=
AUPHONIC_CLIENT_ID=            # optional, from auphonic.com/me

# ElevenLabs API key — used for "Background music" (and SFX when available).
# Leave unset to skip music/SFX (the edit still completes, flagged in progress).
ELEVENLABS_API_KEY=

# Optional overrides (defaults shown)
PORT=8481
CHROME_PATH=/usr/bin/google-chrome
FFMPEG_PATH=                   # auto-detected: PATH, then ~/tools/ffmpeg/ffmpeg
PYTHON_PATH=python3
